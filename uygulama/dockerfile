FROM php:8.2-apache

# Gerekli PHP eklentilerini kur (PDO MySQL ve Redis)
RUN docker-php-ext-install pdo pdo_mysql
RUN pecl install redis && docker-php-ext-enable redis

# Apache mod_rewrite modülünü etkinleştir ve .htaccess yetkisi ver
RUN a2enmod rewrite
RUN echo '<Directory /var/www/html/>' >> /etc/apache2/apache2.conf \
    && echo '    AllowOverride All' >> /etc/apache2/apache2.conf \
    && echo '</Directory>' >> /etc/apache2/apache2.conf

WORKDIR /var/www/html
COPY . /var/www/html/

# Apache'yi 8000 portunu dinleyecek şekilde ayarla
RUN sed -i 's/80/8000/g' /etc/apache2/ports.conf /etc/apache2/sites-available/000-default.conf

EXPOSE 8000